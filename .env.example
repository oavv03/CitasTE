# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Optional. Secret key for sending real transactional emails via Resend.
# If not configured, the application runs seamlessly in safe high-fidelity Simulation Mode.
RESEND_API_KEY=


# RESEND_FROM_EMAIL: Optional. Custom verified email sender address when using a custom Resend domain (e.g. "Tribunal Electoral <citas@midominio.com>").
# Defaults to "Tribunal Electoral <onboarding@resend.dev>".
RESEND_FROM_EMAIL=

